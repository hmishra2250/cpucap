#!/bin/bash
# cpucap — cap CPU speed to control heat (intel_pstate).
# Usage: sudo cpucap cool|quiet|normal|full|status
P=/sys/devices/system/cpu/intel_pstate
set_cap(){ echo "$1" > $P/no_turbo; echo "$2" > $P/max_perf_pct; }
case "$1" in
  cool)   set_cap 1 60 ;;   # no turbo, ~3.2 GHz max — big heat drop, still snappy
  quiet)  set_cap 1 45 ;;   # no turbo, ~2.4 GHz max — coolest/quietest
  normal) set_cap 1 100 ;;  # no turbo, base clocks uncapped
  full)   set_cap 0 100 ;;  # stock: turbo to 5.3 GHz
  status|"") ;;
  *) echo "usage: sudo cpucap cool|quiet|normal|full|status"; exit 1 ;;
esac
echo "turbo: $([ "$(cat $P/no_turbo)" = 1 ] && echo off || echo on)   max_perf: $(cat $P/max_perf_pct)%"
echo "CPU temp: $(( $(cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | sort -n | tail -1)/1000 ))°C   avg clock: $(awk '/MHz/{s+=$4;n++} END{printf "%.0f", s/n}' /proc/cpuinfo) MHz"
